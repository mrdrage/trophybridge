# Supabase browser/session configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# PlayStation trophy metadata is requested in the language used by the pilot player.
PSN_TROPHY_LOCALE=it-IT

# 32-byte AES-256-GCM application key encoded as base64.
# Generate outside source control and store only in the deployment environment.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1

# Optional JSON object containing older key versions during key rotation.
# Example shape only: {"1":"<old-base64-key>"}
TOKEN_ENCRYPTION_PREVIOUS_KEYS_JSON={}

# M4 free-tier guardrails. Library sync is manual, at most once per hour by default,
# and refuses unexpectedly large provider responses before any database write.
LIBRARY_SYNC_MIN_INTERVAL_SECONDS=3600
LIBRARY_SYNC_MAX_GAMES=2000
LIBRARY_SYNC_STALE_AFTER_SECONDS=600

# M5 free-tier guardrails. Deep trophy sync is manual and scoped to one selected game.
GAME_SYNC_MIN_INTERVAL_SECONDS=300
GAME_SYNC_MAX_GROUPS=100
GAME_SYNC_MAX_TROPHIES=1000
GAME_SYNC_STALE_AFTER_SECONDS=600

# Canonical application origin. Use http://localhost:3001 locally if port 3000 is busy.
APP_URL=http://localhost:3000
