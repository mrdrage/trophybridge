# Public Supabase configuration used by the browser client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte application encryption key encoded for the deployment environment.
TOKEN_ENCRYPTION_KEY=

# Canonical application origin, for example https://trophybridge.example.com
APP_URL=http://localhost:3000
